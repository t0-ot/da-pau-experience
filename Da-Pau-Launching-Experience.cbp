<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Da-Pau-Launching-Experience" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="DEBUG_LINUX">
				<Option output="bin/Debug/Da-Pau-Eating-Experience" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="external/raylib/src" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-lGL -lm -lpthread -ldl -lrt -lX11" />
					<Add library="raylib" />
					<Add directory="external/raylib/src" />
				</Linker>
			</Target>
			<Target title="RELEASE_LINUX">
