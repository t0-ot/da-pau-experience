				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="external/raylib/src" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-static-libgcc" />
					<Add option="-lGL -lm -lpthread -ldl -lrt -lX11" />
					<Add library="raylib" />
					<Add directory="external/raylib/src" />
				</Linker>
				<MakeCommands>
					<Build command="$make -f $makefile $target" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -f $makefile clean" />
					<DistClean command="$make -f $makefile distclean$target" />
					<AskRebuildNeeded command="$make -q -f $makefile $target" />
					<SilentBuild command="$make -f $makefile $target &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="asan">
				<Option output="bin/Debug-Asan/Da-Pau-Launching-Experience" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-g -fsanitize=address,undefined,leak,pointer-compare,pointer-subtract" />
					<Add directory="external/raylib/src" />
				</Compiler>
				<Linker>
					<Add option="-fsanitize=address,undefined,leak,pointer-compare,pointer-subtract" />
					<Add option="-lGL -lm -lpthread -ldl -lrt -lX11" />
					<Add library="raylib" />
					<Add directory="external/raylib/src" />
				</Linker>
				<MakeCommands>
					<Build command="$make -f $makefile $target" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -f $makefile clean" />
					<DistClean command="$make -f $makefile distclean$target" />
					<AskRebuildNeeded command="$make -q -f $makefile $target" />
					<SilentBuild command="$make -f $makefile $target &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
